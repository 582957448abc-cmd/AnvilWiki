---
import OceanArticle from '~/components/ocean/OceanArticle.astro';
import { articles } from '~/content/specials/drink-the-ocean-guides';
export function getStaticPaths() {
  return Object.entries(articles).map(([slug, content]) => ({
    params: { article: slug },
    props: { content },
  }));
}
---

<OceanArticle locale="en" content={Astro.props.content} />
