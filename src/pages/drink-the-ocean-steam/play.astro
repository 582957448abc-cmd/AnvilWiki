---
import { articles } from '~/content/specials/drink-the-ocean-guides';
const gameUrl = 'https://playgama.com/export/game/drink-the-ocean';
const controls = [
  ['W A S D', 'Move'],
  ['Mouse', 'Look around'],
  ['Left click', 'Hold to drink'],
  ['Space', 'Jump'],
  ['1 / 2 / 3', 'Switch unlocked tools'],
  ['T', 'Return home'],
  ['P', 'Settings'],
  ['Tab', 'Release the cursor'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Play Drink the Ocean in Your Browser</title>
  </head>
  <body>
    <header>
      <a href="../">← Back to the guide</a>
    </header>
    <main>
      <div class="intro">
        <div>
          <h1>Play Drink the Ocean</h1>
          <p>Free browser game hosted by Playgama. The first load may take a moment.</p>
        </div>
        <button type="button" data-fullscreen hidden>Fullscreen</button>
      </div>
      <div class="player" id="player">
        <iframe
          src={gameUrl}
          title="Drink the Ocean browser game"
          allow="autoplay; fullscreen; gamepad"
          allowfullscreen></iframe>
      </div>
      <div class="share">
        <button type="button" data-share>Share game</button>
        <input type="url" readonly aria-label="Game page link" data-share-url hidden />
        <span role="status" data-share-status></span>
      </div>
      <p class="hint">
        Click inside the game to focus it. Press Tab to release the mouse and return to the page.
      </p>
      <section aria-labelledby="controls-title">
        <h2 id="controls-title">Keyboard and mouse controls</h2>
        <dl>
          {
            controls.map(([key, action]) => (
              <div>
                <>
                  <dt>
                    <kbd>{key}</kbd>
                  </dt>
                  <dd>{action}</dd>
                </>
              </div>
            ))
          }
        </dl>
      </section>
      <section aria-labelledby="guide-title">
        <h2 id="guide-title">How to play Drink the Ocean</h2>
        <ol class="steps">
          <li>
            <strong>Fill up at the shore.</strong> Walk to the water with WASD and hold left click until
            your belly is full.
          </li>
          <li>
            <strong>Turn water into salt.</strong> Return to the PRESS and empty your belly there. Salt
            is the currency for upgrades.
          </li>
          <li>
            <strong>Upgrade at the blue SHOP pad.</strong> Start with more belly capacity or a better
            straw so each trip moves more water.
          </li>
          <li>
            <strong>Repeat as the shoreline recedes.</strong> Use the number keys to switch tools as you
            unlock them. Press T if you need to get back home.
          </li>
        </ol>
        <p>
          On a touch device, use the on-screen movement and Drink controls if the game displays
          them.
        </p>
      </section>
      <nav class="guides" aria-label="More guides">
        {
          Object.entries(articles).map(([slug, article]) => (
            <a href={'../' + slug + '/'}>{article.title} →</a>
          ))
        }
      </nav>
    </main>
    <script is:inline>
      const shareButton = document.querySelector('[data-share]');
      const shareInput = document.querySelector('[data-share-url]');
      const shareStatus = document.querySelector('[data-share-status]');
      const shareUrl = new URL(location.pathname, location.origin).href;

      shareButton.addEventListener('click', async () => {
        shareStatus.textContent = '';
        if (navigator.share) {
          try {
            await navigator.share({ title: 'Play Drink the Ocean', url: shareUrl });
            return;
          } catch (error) {
            if (error.name === 'AbortError') return;
          }
        }
        try {
          await navigator.clipboard.writeText(shareUrl);
          shareStatus.textContent = 'Link copied';
        } catch {
          shareInput.value = shareUrl;
          shareInput.hidden = false;
          shareInput.select();
          shareStatus.textContent = 'Copy the selected link';
        }
      });

      const button = document.querySelector('[data-fullscreen]');
      const player = document.getElementById('player');
      if (document.fullscreenEnabled) {
        button.hidden = false;
        button.addEventListener('click', async () => {
          try {
            if (document.fullscreenElement) await document.exitFullscreen();
            else await player.requestFullscreen();
          } catch {
            player.querySelector('iframe').focus();
          }
        });
      }
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: #062736;
    color: #f7f3e9;
    font:
      16px/1.55 system-ui,
      sans-serif;
  }
  header,
  main {
    width: min(1100px, calc(100% - 32px));
    margin-inline: auto;
  }
  header {
    padding-block: 1rem;
  }
  header a {
    color: inherit;
    text-underline-offset: 0.25em;
  }
  main {
    padding-bottom: 3rem;
  }
  .intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  h1,
  h2 {
    margin: 0 0 0.35rem;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3.6rem);
  }
  p {
    margin: 0.55rem 0 0;
    color: #c2d9dd;
  }
  button {
    background: #ffab77;
    color: #252322;
    border: 0;
    border-radius: 100px;
    padding: 0.7rem 1.1rem;
    font: inherit;
    font-weight: 750;
    cursor: pointer;
  }
  .player {
    display: flex;
    height: clamp(440px, 72vh, 760px);
    background: #031822;
    border: 1px solid #416374;
    border-radius: 18px;
    overflow: hidden;
  }
  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .player:fullscreen {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
  }
  .hint {
    font-size: 0.9rem;
  }
  section {
    margin-top: 2rem;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(147px, 1fr));
    gap: 0.55rem;
  }
  dl div {
    padding: 0.7rem;
    border: 1px solid #416374;
    border-radius: 0.6rem;
    background: #0e3543;
  }
  dd {
    margin: 0.25rem 0 0;
    color: #c2d9dd;
  }
  kbd {
    color: #ffbe95;
    font-size: 0.95rem;
  }
  ol {
    padding-left: 1.35rem;
    max-width: 70ch;
  }
  li {
    margin: 0.75rem 0;
  }
  @media (max-width: 600px) {
    .player {
      height: clamp(390px, 70svh, 650px);
    }
  }
  .share {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1rem;
  }
  .share button {
    background: #e3eee9;
    color: #12353d;
  }
  .share input {
    width: min(100%, 360px);
    padding: 0.65rem;
    border: 0;
    border-radius: 6px;
    font: inherit;
  }
  .share span,
  .hint {
    color: #dcebea;
  }
  section {
    max-width: 850px;
    padding: clamp(16px, 4vw, 32px);
    border: 1px solid #416374;
    background: #0a303e;
    border-radius: 16px;
    font-size: 1.08rem;
  }
  section h2 {
    font-size: clamp(1.45rem, 4vw, 2rem);
    margin-bottom: 1rem;
  }
  .steps {
    padding-left: 1.5rem;
    line-height: 1.7;
  }
  .steps li {
    padding-left: 0.3rem;
    margin-block: 1rem;
  }
  .steps li::marker {
    color: #ffbe95;
    font-weight: 800;
  }
  .steps strong {
    display: block;
    color: #fff7e8;
    font-size: 1.13rem;
  }
  .guides {
    display: flex;
    gap: 0.65rem 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .guides a {
    color: #ffbe95;
    font-weight: 750;
    text-underline-offset: 0.22em;
  }
</style>
