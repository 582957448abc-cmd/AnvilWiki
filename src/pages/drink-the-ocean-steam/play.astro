---
import { guide } from '~/content/specials/drink-the-ocean';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Play Drink The Ocean</title>
  </head>
  <body>
    <header>
      <a href="../" aria-label="Back to the guide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"></path></svg>
        Drink The Ocean
      </a>
      <button type="button" data-fullscreen aria-label="Toggle fullscreen">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6"></path></svg
        >
      </button>
    </header>
    <main>
      <img src={guide.media + 'cover.webp'} alt="" fetchpriority="high" />
      <div class="panel">
        <h1>Drink The Ocean</h1>
        <div class="progress-header">
          <p class="label" id="preview-label" role="status">Loading screen preview</p>
          <span class="percentage" data-percentage aria-hidden="true">0%</span>
        </div>
        <progress class="track" max="100" value="0" aria-labelledby="preview-label"></progress>
        <p class="description">The loading screen preview may take a moment on your first visit.</p>
      </div>
    </main>
    <script is:inline>
      const progress = document.querySelector('.track');
      const percentage = document.querySelector('[data-percentage]');
      const label = document.getElementById('preview-label');
      const duration = 180_000;
      const startedAt = performance.now();
      const timer = setInterval(() => {
        const elapsed = Math.min(duration, performance.now() - startedAt);
        const percent = (elapsed / duration) * 100;
        progress.value = percent;
        percentage.textContent = `${Math.floor(percent)}%`;

        if (elapsed === duration) {
          clearInterval(timer);
          label.textContent = 'Preview complete';
        }
      }, 200);

      const fullscreenButton = document.querySelector('[data-fullscreen]');
      if (!document.fullscreenEnabled) {
        fullscreenButton.hidden = true;
      } else {
        fullscreenButton.addEventListener('click', async () => {
          try {
            if (document.fullscreenElement) await document.exitFullscreen();
            else await document.documentElement.requestFullscreen();
          } catch {
            // Keep the player available in the current viewport.
          }
        });
      }
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    background: #062736;
    color: #f7f3e9;
    font:
      16px/1.5 system-ui,
      sans-serif;
  }
  header {
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: clamp(14px, 4vw, 48px);
  }
  header a,
  button {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #e0eeec;
    text-decoration: none;
    font: inherit;
    font-weight: 650;
  }
  button {
    background: transparent;
    border: 1px solid #51717c;
    border-radius: 50%;
    cursor: pointer;
    padding: 9px;
  }
  button[hidden] {
    display: none;
  }
  svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  main {
    position: relative;
    isolation: isolate;
    flex: 1;
    display: grid;
    place-items: center;
    padding: 24px;
    overflow: hidden;
  }
  main img,
  main::after {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }
  main img {
    object-fit: cover;
    object-position: 68% center;
  }
  main::after {
    content: '';
    z-index: -1;
    background: #031e3090;
  }
  .panel {
    width: min(100%, 29rem);
    text-align: center;
    padding: clamp(26px, 5vw, 50px);
    border: 1px solid #c8e6e753;
    border-radius: 22px;
    background: #092b39f0;
    box-shadow: 0 16px 65px #00121f60;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.06em;
    margin: 0 0 1.1rem;
  }
  .label {
    font-weight: 700;
    margin: 0 0 0.7rem;
  }
  .description {
    color: #c2d9dd;
    margin: 1rem 0 0;
    font-size: 0.9rem;
  }
  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    text-align: left;
  }
  .percentage {
    font-variant-numeric: tabular-nums;
  }
  .percentage {
    color: #ffab77;
    font-weight: 750;
  }
  .track {
    appearance: none;
    display: block;
    width: 100%;
    height: 7px;
    border: 0;
    border-radius: 10px;
    background: #416374;
    accent-color: #ffab77;
    overflow: hidden;
  }
  .track::-webkit-progress-bar {
    background: #416374;
    border-radius: 10px;
  }
  .track::-webkit-progress-value {
    background: #ffab77;
    border-radius: 10px;
  }
  .track::-moz-progress-bar {
    background: #ffab77;
    border-radius: 10px;
  }
</style>
