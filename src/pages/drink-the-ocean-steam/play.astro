---
import { guide } from '~/content/specials/drink-the-ocean';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Play Drink The Ocean</title>
  </head>
  <body>
    <header>
      <a href="../" aria-label="Back to the guide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"></path></svg>
        Drink The Ocean
      </a>
      <button type="button" data-fullscreen aria-label="Toggle fullscreen">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6"></path></svg
        >
      </button>
    </header>
    <main>
      <img src={guide.media + 'poster.webp'} alt="" fetchpriority="high" />
      <div class="panel">
        <h1>Drink The Ocean</h1>
        <p class="label">Loading screen preview</p>
        <div class="track" aria-hidden="true"></div>
        <p class="description">
          This preview shows the player layout. The game will appear here when an embeddable build
          is available.
        </p>
      </div>
    </main>
    <script is:inline>
      const fullscreenButton = document.querySelector('[data-fullscreen]');
      if (!document.fullscreenEnabled) {
        fullscreenButton.hidden = true;
      } else {
        fullscreenButton.addEventListener('click', async () => {
          try {
            if (document.fullscreenElement) await document.exitFullscreen();
            else await document.documentElement.requestFullscreen();
          } catch {
            // Keep the player available in the current viewport.
          }
        });
      }
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    background: #111214;
    color: #f6f7f9;
    font:
      16px/1.5 system-ui,
      sans-serif;
  }
  header {
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    border-bottom: 1px solid #2d3034;
  }
  header a,
  button {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #c2c6ce;
    text-decoration: none;
    font: inherit;
    font-weight: 650;
  }
  button {
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 6px;
  }
  button[hidden] {
    display: none;
  }
  svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  main {
    position: relative;
    isolation: isolate;
    flex: 1;
    display: grid;
    align-items: end;
    padding: clamp(22px, 4.5vw, 60px);
  }
  main img,
  main::after {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }
  main img {
    object-fit: cover;
  }
  main::after {
    content: '';
    z-index: -1;
    background: linear-gradient(180deg, transparent 25%, #11121444 50%, #111214 96%);
  }
  .panel {
    width: min(100%, 34rem);
  }
  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 0 0 2rem;
  }
  .label {
    font-weight: 700;
    margin: 0 0 0.65rem;
  }
  .description {
    color: #c2c6ce;
    margin: 1rem 0 0;
  }
  .track {
    height: 4px;
    border-radius: 10px;
    background: #34373c;
    overflow: hidden;
  }
  .track::before {
    content: '';
    display: block;
    width: 26%;
    height: 100%;
    border-radius: inherit;
    background: #f6f7f9;
    animation: loading 1.25s ease-in-out 3 alternate both;
  }
  @keyframes loading {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(285%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track::before {
      animation: none;
    }
  }
</style>
