---
import OceanInfo from '~/components/ocean/OceanInfo.astro';
import { siteInformation } from '~/content/specials/site-information';
export function getStaticPaths() {
  return Object.entries(siteInformation).map(([slug, page]) => ({
    params: { information: slug.slice(1, -1) },
    props: { page },
  }));
}
---

<OceanInfo locale="en" page={Astro.props.page} />
