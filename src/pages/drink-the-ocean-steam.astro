---
const siteOrigin = process.env.SITE_URL;
import { guide } from '~/content/specials/drink-the-ocean';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{guide.title}</title>
    <meta name="description" content={guide.description} />
    {siteOrigin && <link rel="canonical" href={new URL(Astro.url.pathname, siteOrigin).href} />}
    <meta property="og:title" content={guide.title} />
    <meta property="og:description" content={guide.description} />
    {
      siteOrigin && (
        <meta property="og:image" content={new URL(guide.media + 'cover.webp', siteOrigin).href} />
      )
    }
  </head>
  <body>
    <header class="site-bar">
      <div class="bar-inner">
        <a class="wordmark" href="./">Drink The Ocean</a>
        <nav aria-label="On this page">
          <a href="#how-to-play">How to play</a>
          <a href="#preview">Media</a>
          <a href="#faq">FAQ</a>
        </nav>
      </div>
    </header>
    <main class="ocean" data-pagefind-body>
      <img
        class="cover"
        src={guide.media + 'cover.webp'}
        alt="A striped straw stretches from a rocky shore into an ocean whirlpool"
        fetchpriority="high"
      />
      <aside class="game-panel" aria-label="Game and platform information">
        <h1>Drink the Ocean <span>Steam</span></h1>
        <p class="tagline">Drain an ocean, one sip at a time.</p>
        <a class="play-button" href="./play/" aria-describedby="player-note">Play Now</a>
        <p class="player-note" id="player-note">Loading screen preview</p>
        <dl>
          <div><dt>Genre</dt><dd>Incremental</dd></div>
          <div><dt>Input</dt><dd>Keyboard and mouse</dd></div>
          {
            guide.status.map(([label, value]) => (
              <div>
                <>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </>
              </div>
            ))
          }
        </dl>
      </aside>
      <div class="editorial">
        <section aria-labelledby="about-title">
          <h2 id="about-title">About</h2>
          <p>
            <strong>No Steam release has been confirmed.</strong> A desktop browser edition has been listed.
          </p>
          <p>
            Start on a small island with a plastic straw. Each sip lowers the water and uncovers
            more of the seabed. Sell the treasure you find, buy stronger straws, and drain enough
            water to reach the shipwreck.
          </p>
        </section>
        <section id="how-to-play" class="section">
          <h2>How to Play the Drink the Ocean Game</h2>
          <ol>
            {
              guide.steps.map(([title, body]) => (
                <li>
                  <>
                    <h3>{title}</h3>
                    <p>{body}</p>
                  </>
                </li>
              ))
            }
          </ol>
          <p class="note">
            For your first upgrade, alternate between drinking and checking exposed ground for
            treasure. Upgrade timing depends on what you find.
          </p>
        </section>
        <section id="preview" class="section" aria-labelledby="preview-title">
          <h2 id="preview-title">Media</h2>
          <video
            controls
            playsinline
            preload="none"
            poster={guide.media + 'poster.webp'}
            aria-label="Drink the Ocean gameplay footage"
          >
            <source src={guide.media + 'gameplay.mp4'} type="video/mp4" />
          </video>
        </section>
        <section id="faq" class="section">
          <h2>Frequently asked questions</h2>
          {
            guide.faq.map(([question, answer]) => (
              <details>
                <>
                  <summary>{question}</summary>
                  <p>{answer}</p>
                </>
              </details>
            ))
          }
        </section>
      </div>
      <footer>Independent game guide.</footer>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: #111214;
    color: #f4f4f4;
    font:
      16px/1.6 Arial,
      sans-serif;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .site-bar {
    border-bottom: 1px solid #292b2f;
  }
  .bar-inner,
  .ocean {
    max-width: 1280px;
    width: calc(100% - clamp(32px, 6vw, 80px));
    margin-inline: auto;
  }
  .bar-inner {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .wordmark {
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.65rem, 2vw, 1.6rem);
    color: #b9bbc1;
    font-size: 0.88rem;
  }
  nav a:hover {
    color: #fff;
  }
  .ocean {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 20px clamp(24px, 3vw, 40px);
    align-items: start;
    padding-block: 28px 42px;
  }
  .cover {
    width: 100%;
    display: block;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: 14px;
    background: #202225;
  }
  .game-panel {
    grid-column: 2;
    grid-row: 1 / span 2;
    padding-top: 10px;
  }
  h1 {
    max-width: 8em;
    margin: 0 0 1rem;
    font-size: clamp(2.65rem, 5.2vw, 5rem);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.075em;
  }
  h1 span {
    display: block;
    margin-top: 0.7rem;
    font-size: 0.31em;
    line-height: 1;
    letter-spacing: 0.03em;
    color: #b9bbc1;
  }
  .tagline {
    color: #b9bbc1;
    margin: 1.35rem 0 1rem;
  }
  .play-button {
    min-height: 49px;
    display: grid;
    place-items: center;
    padding: 0.65rem 1rem;
    border-radius: 12px;
    background: #f4f4f4;
    color: #111214;
    font-weight: 800;
  }
  .play-button:hover {
    background: #dfe4e8;
  }
  .player-note {
    font-size: 0.78rem;
    color: #b9bbc1;
    margin: 0.4rem 0 1.1rem;
  }
  dl {
    margin: 0;
    border-bottom: 1px solid #34363b;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.62rem 0;
    border-top: 1px solid #34363b;
    font-size: 0.88rem;
  }
  dt {
    color: #b9bbc1;
  }
  dd {
    margin: 0;
    text-align: right;
    font-weight: 700;
  }
  .editorial {
    grid-column: 1;
    min-width: 0;
  }
  .section {
    margin-top: 2.1rem;
  }
  h2 {
    margin: 0 0 0.65rem;
    font-size: 1.2rem;
  }
  h3 {
    margin: 0;
    font-size: 1rem;
  }
  p {
    margin: 0 0 0.9rem;
  }
  ol {
    padding-left: 1.3rem;
  }
  li {
    padding-left: 0.2rem;
  }
  .note,
  footer {
    color: #b9bbc1;
  }
  video {
    display: block;
    width: 100%;
    max-height: 480px;
    background: #090a0b;
    border-radius: 12px;
  }
  details {
    border-top: 1px solid #34363b;
    padding: 0.65rem 0;
  }
  summary {
    cursor: pointer;
    font-weight: 700;
  }
  details p {
    margin: 0.45rem 0 0;
  }
  footer {
    grid-column: 1 / -1;
    padding-top: 1rem;
    border-top: 1px solid #34363b;
    font-size: 0.85rem;
  }
  @media (max-width: 760px) {
    .ocean {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 16px;
    }
    .game-panel,
    .editorial {
      grid-column: 1;
      grid-row: auto;
    }
    .game-panel {
      padding-top: 0;
    }
    h1 {
      max-width: none;
    }
    h1 span {
      display: inline;
    }
  }
</style>
