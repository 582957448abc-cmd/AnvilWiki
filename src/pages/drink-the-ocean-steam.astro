---
import { siteUrl as siteOrigin } from '~/config/site';
import { guide } from '~/content/specials/drink-the-ocean';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{guide.title}</title>
    <meta name="description" content={guide.description} />
    {siteOrigin && <link rel="canonical" href={new URL(Astro.url.pathname, siteOrigin).href} />}
    <meta property="og:title" content={guide.title} />
    <meta property="og:description" content={guide.description} />
    {
      siteOrigin && (
        <meta property="og:image" content={new URL(guide.media + 'cover.webp', siteOrigin).href} />
      )
    }
  </head>
  <body>
    <header class="site-bar">
      <div class="bar-inner">
        <a class="wordmark" href="./">Drink The Ocean</a>
        <nav aria-label="On this page">
          <a href="#how-to-play">How to play</a>
          <a href="#preview">Media</a>
          <a href="#faq">FAQ</a>
        </nav>
      </div>
    </header>
    <main class="ocean" data-pagefind-body>
      <section class="hero" aria-labelledby="game-title">
        <img
          class="cover"
          src={guide.media + 'cover.webp'}
          alt="Illustration of an island explorer drinking from a turquoise lagoon through a striped straw"
          fetchpriority="high"
        />
        <div class="hero-copy">
          <h1 id="game-title">{guide.heading}</h1>
          <p class="tagline">Drain an ocean, one sip at a time.</p>
          <p class="steam-status">Steam release unconfirmed</p>
          <div class="hero-actions">
            <a class="play-button" href="./play/" aria-describedby="player-note"
              >Play Now <span aria-hidden="true">→</span></a
            >
            <a class="trailer-link" href="#preview">Watch gameplay</a>
          </div>
          <p class="player-note" id="player-note">Free browser game</p>
        </div>
      </section>
      <aside class="game-panel" aria-label="Game and platform information">
        <dl>
          <div><dt>Genre</dt><dd>Incremental</dd></div>
          <div><dt>Input</dt><dd>Keyboard and mouse</dd></div>
          {
            guide.status.map(([label, value]) => (
              <div>
                <>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </>
              </div>
            ))
          }
        </dl>
      </aside>
      <div class="editorial">
        <section aria-labelledby="about-title">
          <h2 id="about-title">About</h2>
          <p>
            <strong>No Steam release has been confirmed.</strong> A desktop browser edition has been listed.
          </p>
          <p>
            Start on a small island with a plastic straw. Each sip lowers the water and uncovers
            more of the seabed. Sell the treasure you find, buy stronger straws, and drain enough
            water to reach the shipwreck.
          </p>
        </section>
        <section id="how-to-play" class="section">
          <h2>How to Play the Drink the Ocean Game</h2>
          <ol>
            {
              guide.steps.map(([title, body]) => (
                <li>
                  <>
                    <h3>{title}</h3>
                    <p>{body}</p>
                  </>
                </li>
              ))
            }
          </ol>
          <p class="note">
            For your first upgrade, alternate between drinking and checking exposed ground for
            treasure. Upgrade timing depends on what you find.
          </p>
        </section>
        <section id="preview" class="section media-section" aria-labelledby="preview-title">
          <h2 id="preview-title">Gameplay footage</h2>
          <video
            data-gameplay-video
            controls
            muted
            playsinline
            preload="none"
            poster={guide.media + 'poster.webp'}
            aria-label="Drink the Ocean gameplay footage"
          >
            <source src={guide.media + 'gameplay.mp4'} type="video/mp4" />
          </video>
        </section>
        <section id="faq" class="section">
          <h2>Frequently asked questions</h2>
          {
            guide.faq.map(([question, answer]) => (
              <details>
                <>
                  <summary>{question}</summary>
                  <p>{answer}</p>
                </>
              </details>
            ))
          }
        </section>
      </div>
      <footer>Independent game guide.</footer>
    </main>
    <script is:inline>
      const footage = document.querySelector('[data-gameplay-video]');
      if (
        'IntersectionObserver' in window &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            if (entry.intersectionRatio < 0.5) return;
            observer.disconnect();
            if (!footage.paused || footage.currentTime > 0) return;
            footage.muted = true;
            footage.play().catch(() => {
              // The native play button remains available if autoplay is blocked.
            });
          },
          { threshold: 0.5 },
        );
        observer.observe(footage);
      }
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: #f7f3e9;
    color: #132f36;
    font:
      16px/1.6 system-ui,
      sans-serif;
  }
  a {
    color: inherit;
  }
  .site-bar {
    border-bottom: 1px solid #d5ded7;
  }
  .bar-inner,
  .ocean {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }
  .bar-inner {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .wordmark {
    font-weight: 850;
    letter-spacing: -0.04em;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: clamp(0.55rem, 3vw, 1.8rem);
    font-size: 0.88rem;
  }
  nav a,
  .wordmark {
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
  }
  .ocean {
    padding-block: clamp(16px, 3vw, 32px) 45px;
  }
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    overflow: hidden;
    min-height: clamp(430px, 49vw, 570px);
    border-radius: 25px;
    background: #032538;
    color: #fff8ea;
  }
  .cover,
  .hero::after {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }
  .cover {
    object-fit: cover;
  }
  .hero::after {
    content: '';
    z-index: -1;
    background: linear-gradient(90deg, #042638 0%, #042638e0 26%, #04263800 70%);
  }
  .hero-copy {
    padding: clamp(26px, 5vw, 70px);
  }
  h1 {
    max-width: 8em;
    margin: 0;
    font-size: clamp(3.4rem, 7.2vw, 6.2rem);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: -0.075em;
    text-wrap: balance;
  }
  .tagline {
    margin: 1.15rem 0 0.5rem;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }
  .steam-status,
  .player-note {
    color: #d5e6e7;
    font-size: 0.85rem;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem 1.15rem;
    margin-top: 1.5rem;
  }
  .play-button {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 50px;
    padding: 0.7rem 1.1rem;
    border-radius: 99px;
    background: #ffab77;
    color: #252322;
    font-weight: 800;
    text-decoration: none;
  }
  .play-button:hover {
    background: #ffc39d;
  }
  .trailer-link {
    text-underline-offset: 0.22em;
  }
  .player-note {
    margin: 0.65rem 0 0;
  }
  .game-panel {
    margin-block: 24px 34px;
    padding: 16px 22px;
    border: 1px solid #d6e2d9;
    border-radius: 16px;
    background: #e7efe7;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1rem;
    margin: 0;
  }
  dt {
    color: #41615e;
    font-size: 0.78rem;
  }
  dd {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    font-weight: 750;
  }
  .editorial {
    max-width: 760px;
    margin-inline: auto;
  }
  .section {
    margin-top: 2.4rem;
  }
  h2 {
    margin: 0 0 0.65rem;
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    letter-spacing: -0.035em;
    line-height: 1.2;
  }
  h3 {
    margin: 0;
    font-size: 1rem;
  }
  p {
    margin: 0 0 0.9rem;
  }
  ol {
    padding-left: 1.3rem;
  }
  .note,
  footer {
    color: #41615e;
  }
  .media-section {
    padding: clamp(1rem, 4vw, 2rem);
    border: 1px solid #d6e2d9;
    border-radius: 20px;
    background: #e7efe7;
    text-align: center;
  }
  .media-section h2 {
    margin-bottom: 1rem;
  }
  video {
    display: block;
    width: min(100%, 292px, 40dvh);
    aspect-ratio: 9 / 16;
    object-fit: contain;
    margin-inline: auto;
    background: #082733;
    border-radius: 14px;
    box-shadow: 0 8px 22px #132f3625;
  }
  details {
    border-top: 1px solid #d2ddd4;
  }
  summary {
    cursor: pointer;
    padding: 0.75rem 0;
    font-weight: 700;
  }
  details p {
    margin: 0 0 0.75rem;
  }
  footer {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid #d2ddd4;
    font-size: 0.85rem;
  }
  @media (max-width: 680px) {
    .bar-inner,
    .ocean {
      width: calc(100% - 24px);
    }
    .bar-inner {
      gap: 0.5rem;
    }
    .hero {
      align-items: end;
      min-height: 515px;
    }
    .cover {
      object-position: 72% center;
    }
    .hero::after {
      background: linear-gradient(0deg, #042638 9%, #042638e3 36%, #04263800 78%);
    }
    h1 {
      font-size: clamp(2.9rem, 12vw, 4.7rem);
    }
  }
</style>
