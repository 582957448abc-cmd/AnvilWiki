---
import { ptInfo } from '~/content/specials/ocean-pt-br';
import { deInfo } from '~/content/specials/ocean-de';
import { siteInformation } from '~/content/specials/site-information';
const { locale = 'en' } = Astro.props;
---

<footer class="site-info-footer">
  <nav
    aria-label={locale === 'pt-BR'
      ? 'Informações do site'
      : locale === 'de'
        ? 'Informationen zur Website'
        : 'Site information'}
  >
    {
      Object.entries(locale === 'pt-BR' ? ptInfo : locale === 'de' ? deInfo : siteInformation).map(
        ([href, item]) => (
          <a href={(locale === 'pt-BR' ? '/pt-br' : locale === 'de' ? '/de' : '') + href}>
            {item.title}
          </a>
        ),
      )
    }
  </nav>
</footer>
<style>
  .site-info-footer {
    margin-top: 2.5rem;
    padding-block: 1rem;
    border-top: 1px solid currentColor;
    font-size: 0.9rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
  }
  a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
</style>
