---
const { locale } = Astro.props;
const english = Astro.url.pathname.replace(/^\/(?:de|pt-br)(?=\/)/, '');
---

{
  [
    ['en', '', 'English'],
    ['de', '/de', 'Deutsch'],
    ['pt-BR', '/pt-br', 'Português (Brasil)'],
  ]
    .filter(([code]) => code !== locale)
    .map(([code, prefix, label]) => (
      <a href={prefix + english} lang={code} hreflang={code}>
        {label}
      </a>
    ))
}
