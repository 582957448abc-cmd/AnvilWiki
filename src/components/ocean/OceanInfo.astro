---
import OceanLanguageLink from '~/components/ocean/OceanLanguageLink.astro';
import OceanAlternates from '~/components/ocean/OceanAlternates.astro';
import { siteUrl } from '~/config/site';
import OceanSiteFooter from '~/components/layout/OceanSiteFooter.astro';

const { page, locale } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title} | Drink the Ocean Steam</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl).href} />
    <OceanAlternates pathname={Astro.url.pathname} />
  </head>
  <body>
    <main>
      <a href={(locale === 'de' ? '/de' : '') + '/drink-the-ocean-steam/'}
        >{locale === 'de' ? '← Zurück zur Spielübersicht' : '← Back to the game guide'}</a
      >
      <OceanLanguageLink locale={locale} /><h1>{page.title}</h1>
      <p class="date">
        {locale === 'de' ? 'Stand' : 'Last updated'}
        <time datetime="2026-11-14"
          >{locale === 'de' ? '14. November 2026' : 'November 14, 2026'}</time>
      </p>
      {
        page.sections.map(([title, body, label, href]) => (
          <section>
            <h2>{title}</h2>
            <p>{body}</p>
            {href && <a href={href}>{label}</a>}
          </section>
        ))
      }
      <OceanSiteFooter locale={locale} />
    </main>
  </body>
</html>
<style>
  body {
    margin: 0;
    background: #f7f3e9;
    color: #132f36;
    font:
      17px/1.65 system-ui,
      sans-serif;
  }
  main {
    width: min(72ch, calc(100% - 36px));
    margin: 2rem auto 3rem;
  }
  a {
    color: #164e48;
    text-underline-offset: 0.2em;
  }
  h1 {
    font-size: clamp(2rem, 7vw, 3.5rem);
    letter-spacing: -0.05em;
    line-height: 1.1;
    margin: 1.7rem 0 0.4rem;
  }
  h2 {
    font-size: 1.22rem;
    margin: 0 0 0.3rem;
  }
  section {
    margin-top: 1.5rem;
  }
  p {
    margin: 0 0 0.35rem;
  }
  .date {
    color: #41615e;
  }
</style>
